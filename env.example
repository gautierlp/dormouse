# Copy to ~/.config/dormouse/env, then chmod 600.
# Token: Beeper Desktop, Settings, Integrations, "+" next to Approved connections.
BEEPER_ACCESS_TOKEN=
# Dry run until this is exactly 1.
ARCHIVE_ENABLED=0
BEEPER_ARCHIVE_MODEL=qwen3.5:4b
# Comma-separated chat titles to archive once quiet, with no model call (bots).
ALWAYS_ARCHIVE=
